{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SiluPanda/harnesscheck/main/harnesscheck.schema.json",
  "title": "HarnessCheck configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "agents",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trials": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 1
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000,
          "default": 300000
        },
        "assertionTimeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000,
          "default": 60000
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "default": 2
        },
        "keep": {
          "enum": [
            "never",
            "failures",
            "always"
          ],
          "default": "failures"
        },
        "redact": {
          "type": "boolean",
          "default": true
        },
        "outputDir": {
          "type": "string",
          "default": ".harnesscheck"
        },
        "copyExclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 16384,
          "maximum": 100000000
        }
      }
    },
    "agents": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "adapter": {
            "enum": [
              "codex",
              "claude",
              "gemini",
              "opencode",
              "custom"
            ]
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stdin": {
            "type": "boolean"
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "passEnv": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "description": "Additional ambient environment variables to pass to this agent"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fixture",
          "prompt",
          "assertions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "description": {
            "type": "string"
          },
          "fixture": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "agents": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "trials": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600000
          },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "path"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "file_exists",
                        "file_not_exists"
                      ]
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$",
                      "description": "A path relative to the trial workspace without parent traversal"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "path",
                    "value"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "file_contains",
                        "file_not_contains"
                      ]
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$",
                      "description": "A path relative to the trial workspace without parent traversal"
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "path",
                    "pattern"
                  ],
                  "properties": {
                    "type": {
                      "const": "file_matches"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$",
                      "description": "A path relative to the trial workspace without parent traversal"
                    },
                    "pattern": {
                      "type": "string"
                    },
                    "flags": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "command"
                  ],
                  "properties": {
                    "type": {
                      "const": "command_exit"
                    },
                    "command": {
                      "type": "string"
                    },
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "exitCode": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255
                    },
                    "timeoutMs": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "const": "changed_files"
                    },
                    "include": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "exclude": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "min": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "max": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "value"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "stdout_contains",
                        "stdout_not_contains",
                        "stderr_contains",
                        "stderr_not_contains"
                      ]
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
